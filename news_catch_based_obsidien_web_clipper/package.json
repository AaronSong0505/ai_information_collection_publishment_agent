{
  "name": "news-catch-obsidian-clipper",
  "version": "1.0.0",
  "description": "基于 Obsidian Web Clipper 的新闻抓取系统",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node scripts/setup-obsidian-clipper.js",
    "build": "tsc",
    "dev": "tsx src/simple-demo.ts",
    "start": "node dist/simple-demo.js",
    "test": "tsx test/test.ts",
    "demo": "tsx src/simple-demo.ts",
    "demo-real": "tsx src/real-news-demo.ts",
    "demo-ai": "tsx src/ai-news-demo.ts",
    "demo-compare": "tsx src/compare-demo.ts",
    "demo-simple": "node demo-simple.js",
    "manage-sources": "tsx src/manage-sources.ts",
    "config": "tsx src/config-cli.ts",
    "auto-crawl": "tsx src/auto-ai-crawler.ts",
    "data-processing": "tsx src/data-processing-demo.ts",
    "clean": "rimraf dist data/articles.json data/images/*",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "news",
    "crawler",
    "obsidian",
    "web-clipper",
    "ai",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "consola": "^3.2.3",
    "node-cron": "^3.0.3",
    "ofetch": "^1.3.3",
    "jsdom": "^23.0.1",
    "rss-parser": "^3.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/jsdom": "^21.1.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}