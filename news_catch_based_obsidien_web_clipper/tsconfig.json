{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node", "better-sqlite3"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "demo/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "obsidian-clipper"
  ]
}